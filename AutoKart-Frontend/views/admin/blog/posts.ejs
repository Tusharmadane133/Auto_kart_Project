<h2>Blog Posts</h2>
  
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <div></div>
    <a href="/admin/blog/create" class="btn btn-primary">Create New Post</a>
  </div>

  <div class="search-box">
    <input type="text" id="searchInput" placeholder="Search posts..." onkeyup="searchPosts()">
  </div>

  <div id="loadingSpinner" style="text-align: center; padding: 20px;">
    <div>Loading...</div>
  </div>

  <div id="blogPostsContainer">
    <!-- Posts will be loaded here -->
  </div>

  <div id="paginationContainer">
    <!-- Pagination will be loaded here -->
  </div>

  <script>
    let currentPage = 1;
    let searchQuery = '';

    function loadPosts(page = 1, search = '') {
      currentPage = page;
      searchQuery = search;
      
      const loadingSpinner = document.getElementById('loadingSpinner');
      const container = document.getElementById('blogPostsContainer');
      
      loadingSpinner.style.display = 'block';
      container.innerHTML = '';

      fetch(`/admin/api/blog/posts?page=${page}&search=${encodeURIComponent(search)}`)
        .then(response => response.json())
        .then(data => {
          loadingSpinner.style.display = 'none';
          displayPosts(data.posts);
          displayPagination(data.pagination);
        })
        .catch(error => {
          console.error('Error loading posts:', error);
          loadingSpinner.style.display = 'none';
          container.innerHTML = '<p>Error loading posts. Please try again.</p>';
        });
    }

    function displayPosts(posts) {
      const container = document.getElementById('blogPostsContainer');
      
      if (posts.length === 0) {
        container.innerHTML = '<p>No blog posts found.</p>';
        return;
      }

      const tableHTML = `
        <table class="table">
          <thead>
            <tr>
              <th>Title</th>
              <th>Author</th>
              <th>Status</th>
              <th>Excerpt</th>
              <th>Created</th>
              <th>Views</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            ${posts.map(post => `
              <tr>
                <td><strong>${post.title}</strong></td>
                <td>${post.author}</td>
                <td>
                  <span class="status-badge status-${post.status}">
                    ${post.status.charAt(0).toUpperCase() + post.status.slice(1)}
                  </span>
                </td>
                <td class="excerpt">${post.excerpt || 'No excerpt'}</td>
                <td>${new Date(post.created_at).toLocaleDateString()}</td>
                <td>${post.view_count || 0}</td>
                <td>
                  <div class="actions">
                    <a href="/admin/blog/edit/${post.id}" class="btn btn-warning btn-sm">Edit</a>
                    <button onclick="deletePost(${post.id})" class="btn btn-danger btn-sm">Delete</button>
                  </div>
                </td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      `;

      container.innerHTML = tableHTML;
    }

    function displayPagination(pagination) {
      const container = document.getElementById('paginationContainer');
      
      let paginationHTML = '<div class="pagination">';
      
      if (pagination.has_prev) {
        paginationHTML += `<a href="#" onclick="loadPosts(${pagination.current_page - 1}, '${searchQuery}'); return false;">Previous</a>`;
      }
      
      for (let i = 1; i <= pagination.total_pages; i++) {
        const activeClass = i === pagination.current_page ? 'active' : '';
        paginationHTML += `<a href="#" class="${activeClass}" onclick="loadPosts(${i}, '${searchQuery}'); return false;">${i}</a>`;
      }
      
      if (pagination.has_next) {
        paginationHTML += `<a href="#" onclick="loadPosts(${pagination.current_page + 1}, '${searchQuery}'); return false;">Next</a>`;
      }
      
      paginationHTML += '</div>';
      container.innerHTML = paginationHTML;
    }

    function searchPosts() {
      const searchInput = document.getElementById('searchInput');
      loadPosts(1, searchInput.value);
    }

    function deletePost(postId) {
      if (confirm('Are you sure you want to delete this blog post?')) {
        fetch(`/admin/api/blog/post/${postId}`, {
          method: 'DELETE'
        })
        .then(response => response.json())
        .then(data => {
          if (data.success) {
            loadPosts(currentPage, searchQuery);
          } else {
            alert('Error deleting post: ' + (data.error || 'Unknown error'));
          }
        })
        .catch(error => {
          console.error('Error deleting post:', error);
          alert('Error deleting post. Please try again.');
        });
      }
    }

    // Load posts when page loads
    document.addEventListener('DOMContentLoaded', function() {
      loadPosts();
    });
  </script>
</body>
</html>
