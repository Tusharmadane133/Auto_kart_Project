<!-- ===== CHART SCRIPT ===== -->
<script>
const monthLabels = JSON.parse('<%- JSON.stringify(charts.months || []) %>');
const monthSales  = JSON.parse('<%- JSON.stringify(charts.sales  || []) %>');
const statusData  = JSON.parse('<%- JSON.stringify(charts.status || []) %>');
const monthUsers = JSON.parse('<%- JSON.stringify(charts.users || []) %>');
const monthItems = JSON.parse('<%- JSON.stringify(charts.items || []) %>');


const ctx = document.getElementById("monthlySalesChart").getContext("2d");

/* ---- Force Pure White Canvas ---- */
const cleanBackground = {
  id: 'cleanBackground',
  beforeDraw: (chart) => {
    const {ctx, chartArea} = chart;
    if (!chartArea) return;

    ctx.save();
    ctx.fillStyle = "#ffffff";
    ctx.fillRect(
      chartArea.left,
      chartArea.top,
      chartArea.right - chartArea.left,
      chartArea.bottom - chartArea.top
    );
    ctx.restore();
  }
};

new Chart(ctx, {
  type: "bar",

  data: {
    labels: monthLabels,
    datasets: [{
      label: "Revenue",
      data: monthSales,
      backgroundColor: getPalette(1)[0],

      borderRadius: 6
    }]
  },

  options: {
    responsive: true,
    maintainAspectRatio: false,

    plugins: {
      legend: { display:false },
      tooltip: {
        backgroundColor:"#111827",
        titleColor:"#fff",
        bodyColor:"#e5e7eb",
        callbacks:{
          label:(ctx)=>"Revenue: ₹ " + ctx.raw
        }
      }
    },

    scales: {
      x: {
        grid:{ display:false },
        border:{ display:false },
        ticks:{ color:"#6b7280" }
      },
      y: {
        beginAtZero:true,
        grid:{ display:false },
        border:{ display:false },
        ticks:{ color:"#6b7280" }
      }
    }
  },

  plugins: [cleanBackground]   // ✅ MUST BE HERE (ROOT LEVEL)
});

/* ================= USER GROWTH LINE ================= */
new Chart(document.getElementById("usersLineChart"), {
  type: "bar",

  data: {
    labels: monthLabels,
    datasets: [{
      label: "New Users",
      data: monthUsers,
      backgroundColor: getPalette(1)[0],

      barThickness: 20,
      maxBarThickness: 20,
      categoryPercentage: 0.4,
      barPercentage: 0.5,

      borderRadius: 3
    }]
  },

  options:{
    responsive:true,
    maintainAspectRatio:false,
    plugins:{ legend:{ display:false } },

    scales:{
      x:{
        grid:{ display:false },
        border:{ display:false },
        ticks:{ color:"#6b7280" }
      },
      y:{
        beginAtZero:true,
        grid:{ display:false },
        border:{ display:false },
        ticks:{ color:"#6b7280", precision:0 }
      }
    }
  }
});




new Chart(document.getElementById("itemsLineChart"), {
  type: "line",

  data: {
    labels: monthLabels,
    datasets: [{
      label: "Items Sold",
      data: monthItems,
      borderColor: getPalette(1)[0],
      backgroundColor: "transparent",
      tension: 0.4,
      pointRadius: 5,
      pointHoverRadius: 7,
      spanGaps: false   // 🔥 THIS prevents fake connection over nulls
    }]
  },

  options:{
    responsive:true,
    maintainAspectRatio:false,
    plugins:{ legend:{ display:false } },

    scales:{
      x:{ grid:{ display:false }, border:{ display:false }},
      y:{ beginAtZero:true, grid:{ display:false }, border:{ display:false }}
    }
  }
});



new Chart(document.getElementById("orderStatusChart"), {
  type: "doughnut",
  data: {
    labels: ["Delivered", "Pending", "Cancelled"],
    datasets: [{
      data: statusData
    }]
  }
});




const sectionLabels = JSON.parse('<%- JSON.stringify(charts.sections || []) %>');
const sectionCounts = JSON.parse('<%- JSON.stringify(charts.sectionCounts || []) %>');

new Chart(document.getElementById("sectionPieChart"), {
  type: "pie",
  data: {
    labels: sectionLabels,
    datasets: [{
  data: sectionCounts,
backgroundColor: getPalette(sectionCounts.length),
  borderWidth: 0
}]

  },
  options: {
    responsive: true,
    plugins: {
      legend: {
        position: "right"
      },
      tooltip: {
        callbacks: {
          label: function(context) {
            const total = context.dataset.data.reduce((a,b)=>a+b,0);
            const value = context.raw;
            const percent = ((value/total)*100).toFixed(1);
            return `${context.label}: ${percent}% (${value} orders)`;
          }
        }
      }
    }
  }
});

</script>




<script>
const fromInput = document.getElementById("fromDate");
const toInput   = document.getElementById("toDate");

/* ===============================
   WHEN FROM DATE CHANGES
=============================== */
fromInput.addEventListener("change", function () {

  if (!this.value) return;

  // 1️⃣ Prevent selecting TO before FROM
  toInput.min = this.value;

  // 2️⃣ If TO already selected but invalid → auto-fix it
  if (toInput.value && toInput.value < this.value) {
    toInput.value = this.value;
  }
});


/* ===============================
   WHEN TO DATE CHANGES
=============================== */
toInput.addEventListener("change", function () {

  if (!this.value) return;

  // Prevent selecting FROM after TO
  fromInput.max = this.value;

  if (fromInput.value && fromInput.value > this.value) {
    fromInput.value = this.value;
  }
});


/* ===============================
   ON PAGE LOAD (IMPORTANT)
   Restore validation after reload
=============================== */
window.addEventListener("load", function(){

  if(fromInput.value){
    toInput.min = fromInput.value;
  }

  if(toInput.value){
    fromInput.max = toInput.value;
  }

});
</script>



<script>

const subsectionCharts = JSON.parse('<%- JSON.stringify(subsectionCharts || []) %>');

subsectionCharts.forEach((chart, index) => {

 const colors = getPalette(chart.data.length);


  new Chart(document.getElementById(`subChart_${index}`), {
    type: "doughnut",   // 👈 better visual than plain pie
    data: {
      labels: chart.labels,
      datasets: [{
        data: chart.data,
        backgroundColor: colors,
        borderColor: "#ffffff",
        borderWidth: 2,
        hoverOffset: 8
      }]
    },
    options: {
  maintainAspectRatio:false,

  cutout:"50%",      // thinner hole = bigger donut
  radius:"95%",      // force donut to expand

  layout:{
    padding:4        // remove internal whitespace
  },

  plugins:{
    legend:{
      position:"right",

      labels:{
        boxWidth:10,     // smaller bullet
        boxHeight:10,
        padding:10,

        font:{
          size:11        // 👈 reduce text size (important)
        }
      }
    },

    tooltip:{
      callbacks:{
        label:function(ctx){
          const total = ctx.dataset.data.reduce((a,b)=>a+b,0);
          const value = ctx.raw;
          const pct = ((value/total)*100).toFixed(1);
          return `${ctx.label}: ${pct}% (${value})`;
        }
      }
    }
  }
}

  });

});
</script>
<script>
/* ---------- Helper: Format Date in IST-safe way ---------- */
function formatLocalDate(date){
  const year  = date.getFullYear();
  const month = String(date.getMonth() + 1).padStart(2, '0');
  const day   = String(date.getDate()).padStart(2, '0');
  return `${year}-${month}-${day}`;   // YYYY-MM-DD
}


/* ---------- Preset Change Handler ---------- */
document.getElementById("preset").addEventListener("change", function(){

  const now = new Date();   // current time
  let from = null;
  let to   = null;

  /* ---- TODAY ---- */
  if(this.value === "today"){
    from = new Date(now);
    to   = new Date(now);
  }

  /* ---- THIS WEEK (Monday → Today) ---- */
  if(this.value === "week"){
    const current = new Date(now); // clone (avoid mutation)

    const day = current.getDay();  // 0=Sun,1=Mon...
    const mondayOffset = (day === 0 ? -6 : 1 - day);

    from = new Date(current);
    from.setDate(current.getDate() + mondayOffset);

    to = new Date(now);
  }

  /* ---- THIS MONTH ---- */
  if(this.value === "month"){
    from = new Date(now.getFullYear(), now.getMonth(), 1);
    to   = new Date(now);
  }
  
  /* ---- THIS YEAR ---- */
if(this.value === "year"){
  from = new Date(now.getFullYear(), 0, 1);   // Jan 1
  to   = new Date(now.getFullYear(), 11, 31); // Dec 31
}

  /* ---- Apply to Inputs ---- */
  if(from && to){
    document.getElementById("fromDate").value = formatLocalDate(from);
    document.getElementById("toDate").value   = formatLocalDate(to);
  }
});


/* ---------- Restore Values After Page Reload ---------- */
const urlParams = new URLSearchParams(window.location.search);

if(urlParams.get("from")){
  document.getElementById("fromDate").value = urlParams.get("from");
}

if(urlParams.get("to")){
  document.getElementById("toDate").value = urlParams.get("to");
}

if(urlParams.get("preset")){
  document.getElementById("preset").value = urlParams.get("preset");
}
/* ---------- Default to THIS YEAR if no filter provided ---------- */
if(!urlParams.get("from") && !urlParams.get("to")){
  const now = new Date();

  const from = new Date(now.getFullYear(), 0, 1);
  const to   = new Date(now.getFullYear(), 11, 31);

  document.getElementById("preset").value = "year";
  document.getElementById("fromDate").value = formatLocalDate(from);
  document.getElementById("toDate").value   = formatLocalDate(to);

  // auto submit so backend loads correct data
  document.getElementById("dateFilterForm").submit();
}

</script>
