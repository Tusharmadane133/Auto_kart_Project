<script>
/* ================= THEME ENGINE ================= */

const CHART_PALETTES = [
  ["#2563eb","#60a5fa","#93c5fd","#1d4ed8"],   // Blue
  ["#059669","#34d399","#6ee7b7","#047857"],   // Green
  ["#ea580c","#fb923c","#fdba74","#c2410c"],   // Orange
  ["#7c3aed","#a78bfa","#c4b5fd","#5b21b6"],   // Purple
  ["#dc2626","#f87171","#fca5a5","#991b1b"],   // Red
  ["#0f766e","#5eead4","#99f6e4","#134e4a"]    // Teal
];

/* Shuffle palettes every reload */
const SHUFFLED = CHART_PALETTES.sort(()=>0.5-Math.random());

let paletteIndex = 0;

function getPalette(count){
  const palette = SHUFFLED[paletteIndex % SHUFFLED.length];
  paletteIndex++;

  const colors = [];
  for(let i=0;i<count;i++){
    colors.push(palette[i % palette.length]);
  }
  return colors;
}
</script>
<!-- ===== INTERNAL PAGE STYLES ===== -->
<style>

/* ===== PAGE ===== */
.overview-title{
  font-size:22px;
  font-weight:600;
  color:#1e293b;
  margin-bottom:20px;
}

/* ===== KPI GRID ===== */
.kpi-wrapper{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
  gap:18px;
  margin-bottom:28px;
}

/* ===== KPI CARD ===== */
.kpi-box{
  background:#ffffff;
  border-radius:10px;
  padding:20px 22px;
  border:1px solid #e5e7eb;
  box-shadow:0 1px 2px rgba(0,0,0,0.04);
  position:relative;
}

/* Accent bar */
.kpi-box::before{
  content:"";
  position:absolute;
  left:0;
  top:0;
  bottom:0;
  width:3px;
  border-radius:10px 0 0 10px;
  background:var(--theme-color);
}

.kpi-heading{
  font-size:12px;
  letter-spacing:.08em;
  text-transform:uppercase;
  color:#64748b;
  margin-bottom:8px;
}

.kpi-number{
  font-size:28px;
  font-weight:700;
  color:#0f172a;
}

.kpi-desc{
  font-size:12px;
  color:#94a3b8;
  margin-top:4px;
}

/* ===== CHART GRID ===== */
.chart-grid{
  display:grid;
  grid-template-columns:2fr 1fr;
  gap:20px;
}

/* ===== CHART CARD ===== */
.chart-container{
  background:#ffffff;
  border:1px solid #e5e7eb;
  border-radius:10px;
  padding:20px;
}

.chart-title{
  font-size:15px;
  font-weight:600;
  color:#0f172a;
  margin-bottom:15px;
}

canvas{
  max-height:320px;
}

@media(max-width:900px){
  .chart-grid{
    grid-template-columns:1fr;
  }
}
/* ===== SUBSECTION PIE GRID (FIXED 3 PER ROW) ===== */
.subsection-grid{
  display:grid;
  grid-template-columns:repeat(3, 1fr);   /* Always 3 */
  gap:20px;
  margin-top:20px;
}

/* Card Layout */
.subsection-grid .chart-container{
  height:260px;              /* reduce card height */
  padding:16px 18px;         /* tighter padding */
  display:flex;
  flex-direction:column;
  justify-content:space-between;
}

/* Title smaller so chart gets space */
.subsection-grid .chart-title{
  font-size:14px;
  font-weight:600;
  margin-bottom:6px;
}

/* Make canvas take MOST space */
.subsection-grid canvas{
  flex:1 !important;
  max-height:200px !important;
}


#monthlySalesChart{
  height:300px !important;
}
.dual-chart-row{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:20px;
  margin-top:20px;
}


/* ===== HEADER (TITLE + FILTER) ===== */
.overview-header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:24px;
}

/* ===== FILTER BAR ===== */
.date-filter{
  display:flex;
  align-items:center;
  gap:8px;
  background:#ffffff;
  padding:8px 10px;
  border:1px solid #e5e7eb;
  border-radius:8px;
  box-shadow:0 1px 2px rgba(0,0,0,0.04);
}

/* dropdown */
.date-filter select{
  border:none;
  background:#f8fafc;
  padding:6px 10px;
  border-radius:6px;
  font-size:13px;
  color:#0f172a;
}

/* date input */
.date-filter input{
  border:1px solid #e2e8f0;
  padding:5px 8px;
  border-radius:6px;
  font-size:13px;
  background:#ffffff;
}

/* "to" separator */
.range-sep{
  font-size:12px;
  color:#64748b;
  margin:0 2px;
}

/* button */
.date-filter button{
  background:#2563eb;
  color:#fff;
  border:none;
  padding:6px 14px;
