<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Error' %> - AutoKart</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <style>
        .error-container {
            min-height: 80vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
        }
        .error-card {
            max-width: 600px;
            width: 100%;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        }
    </style>
</head>
<body class="bg-gray-100">
    <div class="error-container">
        <div class="error-card bg-white rounded-lg overflow-hidden">
            <div class="px-6 py-4 bg-red-600 text-white">
                <h1 class="text-2xl font-bold"><%= title || 'Oops! Something went wrong' %></h1>
            </div>
            <div class="p-6">
                <p class="text-gray-700 mb-6"><%= message || 'We encountered an error while processing your request.' %></p>
                
                <% if (process.env.NODE_ENV === 'development' && error) { %>
                    <div class="mt-6 p-4 bg-gray-100 rounded-md">
                        <h2 class="text-lg font-semibold text-gray-800 mb-2">Error Details:</h2>
                        <pre class="text-sm text-red-600 overflow-auto"><%= JSON.stringify(error, null, 2) %></pre>
                        <% if (error.stack) { %>
                            <div class="mt-4">
                                <h3 class="font-semibold text-gray-700">Stack Trace:</h3>
                                <pre class="text-xs text-gray-600 mt-2 overflow-auto"><%= error.stack %></pre>
                            </div>
                        <% } %>
                    </div>
                <% } %>
                
                <div class="mt-8">
                    <a href="/" class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-6 rounded-md transition duration-300">
                        Back to Home
                    </a>
                    <button onclick="window.history.back()" class="ml-4 text-blue-600 hover:text-blue-800 font-medium">
                        Go Back
                    </button>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
