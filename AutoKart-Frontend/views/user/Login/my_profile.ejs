
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= __('my_profile') %> | AutoKart</title>
  <link rel="stylesheet" href="styles.css">
  <!-- Font Awesome CDN -->
<link
  rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
  
  <link rel="stylesheet" href="/css/my_profile.css">
</head>
<body>
<%- include('../partials/header') %>



<!-- MAIN CONTAINER -->
<div class="container">

  <!-- LEFT SIDEBAR -->
<aside class="sidebar">
  <div class="user-box">
    <img src="https://cdn-icons-png.flaticon.com/512/149/149071.png">
    <div>
      <p><%= __('hello') %>,</p>
      <h4><%= user.user_first_name %> <%= user.user_last_name %></h4>
      <p><%= __('email_label') %>: <%= user.user_email %></p>
    </div>
  </div>

  <div class="menu">
    <div class="menu-title"><%= __('my_orders') %></div>

    <div class="menu-title"><%= __('account_settings') %></div>
    <a class="active"><%= __('profile_information') %></a>
    <a><%= __('manage_addresses') %></a>
    <a><%= __('pan_card_information') %></a>



    

  </div>
</aside>

<!-- RIGHT CONTENT -->
<main class="content">

  <section class="card">
    <h3>
      <%= __('personal_information') %>
    
    </h3>

    <div class="row">
      <input type="text" value="<%= user.user_first_name %>">
      <input type="text" value="<%= user.user_last_name %>">
    </div>

  
  </section>

  <section class="card">
    <h3>
      <%= __('email_address') %>
    
    </h3>
    <input type="email" value="<%= user.user_email %>">
  </section>

  <section class="card">
    <h3>
      <%= __('mobile_number') %>
    
    </h3>
    <input type="text" value="<%= user.user_mobile %>">
  </section>


</main>

<div class="nav-right">
  
</div>

</body>
</html>