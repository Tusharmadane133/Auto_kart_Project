<%- include('../partials/header') %>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Orders | AutoKart</title>

  <style>
/* ===============================
   BASE
=============================== */
html, body {
  width: 100%;
  max-width: 100%;
  margin: 0;
  background: #f1f3f6;
  font-family: Arial, Helvetica, sans-serif;
  overflow-x: hidden;
}

* {
  box-sizing: border-box;
}

/* ===============================
   PAGE WRAPPER
=============================== */
.orders-page {
  max-width: 1300px;
  margin: 20px auto;
  display: flex;
  gap: 20px;
  width: 100%;
}

/* ===============================
   LEFT FILTER PANEL
=============================== */
.orders-filters {
  width: 260px;
  background: #ffffff;
  padding: 15px;
  border-radius: 4px;
  height: fit-content;
}

.orders-filters h3 {
  font-size: 16px;
  margin-bottom: 15px;
  color: #212121;
}

.filter-group {
  margin-bottom: 20px;
}

.filter-group h4 {
  font-size: 14px;
  margin-bottom: 10px;
  color: #333;
}

.filter-group label {
  display: block;
  font-size: 13px;
  margin-bottom: 6px;
  color: #555;
  cursor: pointer;
}

.filter-group input {
  margin-right: 6px;
}

/* ===============================
   RIGHT CONTENT
=============================== */
.orders-content {
  flex: 1;
  width: 100%;
}

/* ===============================
   ORDERS SEARCH
=============================== */
.orders-search {
  display: flex;
  margin-bottom: 15px;
  width: 100%;
}

.orders-search input {
  flex: 1;
  height: 40px;
  padding: 0 12px;
  border: 1px solid #ccc;
  border-right: none;
  border-radius: 4px 0 0 4px;
  font-size: 14px;
  outline: none;
}

.orders-search button {
  width: 150px;
  height: 40px;
  border: none;
  background: #2874f0;
  color: #ffffff;
  font-size: 14px;
  cursor: pointer;
  border-radius: 0 4px 4px 0;
}

/* ===============================
   ORDER CARD
=============================== */
.order-card {
  background: #ffffff;
  border-radius: 6px;
  padding: 15px;
  display: flex;
  align-items: center;
  gap: 20px;
  margin-bottom: 12px;
  width: 100%;
}

.order-card img {
  width: 90px;
  height: 90px;
  object-fit: contain;
}

.order-info {
  flex: 1;
}

.order-info h4 {
  font-size: 14px;
  margin-bottom: 6px;
  color: #212121;
}

.order-info p {
  font-size: 12px;
  color: #666;
  margin-bottom: 4px;
}

.order-price {
  font-size: 14px;
  font-weight: bold;
  color: #212121;
  white-space: nowrap;
}

/* ===============================
   STATUS BADGE
=============================== */
.order-status {
  display: inline-block;
  padding: 4px 10px;
  border-radius: 12px;
  font-size: 12px;
  font-weight: 600;
  margin-top: 6px;
}

.status-delivered {
  background: #e6f4ea;
  color: #137333;
}

.status-cancelled {
  background: #fee2e2;
  color: #991b1b;
}

/* ===============================
   REVIEW LINK
=============================== */
.review-link {
  font-size: 13px;
  color: #2874f0;
  cursor: pointer;
  margin-top: 6px;
  display: inline-block;
}

/* ===============================
   EMPTY STATE
=============================== */
.no-orders {
  background: #ffffff;
  padding: 40px;
  text-align: center;
  color: #777;
  border-radius: 4px;
}

/* =================================================
   🔥 MOBILE – FILTERS NICHE + BUTTON SMALL
================================================= */
@media (max-width: 768px) {

  /* layout column */
  .orders-page {
    flex-direction: column;
  }

  /* orders upar */
  .orders-content {
    order: 1;
    width: 100%;
  }

  /* filters niche */
  .orders-filters {
    order: 2;
    width: 100%;
    margin-top: 16px;
    padding: 14px;
    border-radius: 8px;
  }

  /* 🔵 ONLY CHANGE: BLUE BUTTON SMALL */
  .orders-search button {
    width: 110px;      /* ⬅ smaller */
    height: 36px;      /* ⬅ shorter */
    font-size: 13px;   /* ⬅ text small */
  }

  .orders-search input {
    height: 36px;
    font-size: 14px;
  }
}


.status-placed {
  background: #e3f2fd;
  color: #0d47a1;
}

.status-confirmed {
  background: #ede7f6;
  color: #4527a0;
}

.status-shipped {
  background: #fff3cd;
  color: #856404;
}

.status-out {
  background: #ffe0b2;
  color: #e65100;
}

.status-delivered {
  background: #e6f4ea;
  color: #137333;
}

.status-cancelled {
  background: #fee2e2;
  color: #991b1b;
}


/* ==========================================
   REVIEW MODAL (Professional UI)
========================================== */
.review-modal {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.55);
  backdrop-filter: blur(4px);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  animation: fadeIn .25s ease;
}

@keyframes fadeIn {
  from {opacity:0;}
  to {opacity:1;}
}

.review-box {
  width: 440px;
  background: #ffffff;
  border-radius: 12px;
  padding: 24px;
  box-shadow: 0 25px 60px rgba(0,0,0,.25);
  animation: scaleIn .25s ease;
}

@keyframes scaleIn {
  from {transform:scale(.9);}
  to {transform:scale(1);}
}

/* Title */
.review-box h3 {
  margin: 0 0 18px;
  font-size: 18px;
  font-weight: 600;
  color: #212121;
}

/* Star Row */
.star-rating {
  display: flex;
  gap: 6px;
  margin-bottom: 16px;
}

.star-rating span {
  font-size: 28px;
  color: #dcdcdc;
  cursor: pointer;
  transition: all .2s ease;
}

.star-rating span:hover {
  transform: scale(1.15);
}

/* Textarea */
.review-box textarea {
  width: 100%;
  height: 90px;
  resize: none;
  border-radius: 8px;
  border: 1px solid #e0e0e0;
  padding: 10px;
  font-size: 14px;
  outline: none;
  transition: border .2s;
  margin-bottom: 14px;
}

.review-box textarea:focus {
  border-color: #2874f0;
}

/* File Upload */
.review-box input[type="file"] {
  font-size: 13px;
  margin-bottom: 18px;
}

/* Buttons Row */
.review-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
}

/* Cancel */
.btn-cancel {
  background: #f1f3f6;
  border: none;
  padding: 8px 16px;
  border-radius: 6px;
  cursor: pointer;
  color: #333;
  font-weight: 500;
}

/* Submit */
.btn-submit {
  background: #2874f0;
  border: none;
  padding: 8px 18px;
  border-radius: 6px;
  cursor: pointer;
  color: #fff;
  font-weight: 600;
  transition: background .2s;
}

.btn-submit:hover {
  background: #1f5fd1;
}

/* ===============================
   RATE & REVIEW ACTION (MATCH UI)
=============================== */
.review-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;

  margin-left: 10px;
  padding: 5px 10px;

  font-size: 12px;
  font-weight: 600;

  color: #2874f0;
  background: #f5faff;

  border: 1px solid #dbe9ff;
  border-radius: 4px;

  cursor: pointer;
  transition: all 0.2s ease;
}

.review-btn:hover {
  background: #eaf3ff;
  border-color: #2874f0;
}
</style>

</head>

<body>

<div class="orders-page">

  <!-- LEFT FILTERS -->
  <div class="orders-filters">
    <h3>Filters</h3>

   <div class="filter-group">
  <h4>ORDER STATUS</h4>

  <label>
    <input type="checkbox" class="status-filter" value="PLACED">
    Placed
  </label>

  <label>
    <input type="checkbox" class="status-filter" value="CONFIRMED">
    Confirmed
  </label>

  <label>
    <input type="checkbox" class="status-filter" value="SHIPPED">
    Shipped
  </label>

  <label>
    <input type="checkbox" class="status-filter" value="OUT_FOR_DELIVERY">
    On the way
  </label>

  <label>
    <input type="checkbox" class="status-filter" value="DELIVERED">
    Delivered
  </label>

  <label>
    <input type="checkbox" class="status-filter" value="CANCELLED">
    Cancelled
  </label>
</div>



    <div class="filter-group">
      <h4>ORDER TIME</h4>
      <label><input type="checkbox"> Last 30 days</label>
      <label><input type="checkbox"> 2024</label>
      <label><input type="checkbox"> 2023</label>
      <label><input type="checkbox"> Older</label>
    </div>
  </div>

  <!-- RIGHT CONTENT -->
  <div class="orders-content">

   

    <% if (!orders || orders.length === 0) { %>

      <div class="no-orders">
        You have not placed any orders yet.
      </div>

    <% } else { %>

      <% orders.forEach(order => { %>

      
<div class="order-card"
     data-status="<%= order.order_status %>"
     onclick="handleCardClick(event, '<%= order.order_id %>')">

          <img
  src="/uploads/<%= order.product_image %>"
  alt="<%= order.product_name %>"
>



<div class="order-info">
  <h4><%= order.product_name %></h4>
  <p>Order ID: <%= order.order_id %></p>
  <p>Qty: <%= order.quantity %></p>

  <% if (order.order_status === 'PLACED') { %>

    <div class="order-status status-placed">
      Order placed on <%= new Date(order.created_at).toDateString() %>
    </div>

  <% } else if (order.order_status === 'CONFIRMED') { %>

    <div class="order-status status-confirmed">
      Order confirmed
    </div>

  <% } else if (order.order_status === 'SHIPPED') { %>

    <div class="order-status status-shipped">
      Shipped
    </div>

  <% } else if (order.order_status === 'OUT_FOR_DELIVERY') { %>

    <div class="order-status status-out">
      Out for delivery
    </div>

  <% } else if (order.order_status === 'DELIVERED') { %>

    <div class="order-status status-delivered">
      Delivered
    </div>
<% if (order.order_status === 'DELIVERED') { %>
<button 
  class="review-btn"
  onclick="event.stopPropagation(); openReviewModal('<%= order.product_id %>', '<%= order.order_id %>')">
  ⭐ Rate & Review Product
</button>
<% } %>
  

  <% } else if (order.order_status === 'CANCELLED') { %>

    <div class="order-status status-cancelled">
      Cancelled
    </div>

  <% } %>
</div>










<div class="order-price">
  ₹<%= order.price %>
</div>

        </div>

      <% }) %>

    <% } %>

  </div>
</div>
<script>
  const statusCheckboxes = document.querySelectorAll('.status-filter');
  const orderCards = document.querySelectorAll('.order-card');

  statusCheckboxes.forEach(cb => {
    cb.addEventListener('change', applyFilters);
  });

  function applyFilters() {
    const activeStatuses = Array.from(statusCheckboxes)
      .filter(cb => cb.checked)
      .map(cb => cb.value);

    orderCards.forEach(card => {
      const orderStatus = card.dataset.status;

      if (activeStatuses.length === 0 || activeStatuses.includes(orderStatus)) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });
  }

</script>




</div> <!-- orders-page END -->

<!-- ✅ KEEP MODAL HERE (GLOBAL, NOT INSIDE CARD) -->
<div id="reviewModal" class="review-modal" style="display:none;">
  <div class="review-box" onclick="event.stopPropagation()">

    <h3>Rate & Review Product</h3>

    <form action="/submit-review" method="POST" enctype="multipart/form-data">

      <input type="hidden" name="product_id" id="modal_product_id">
      <input type="hidden" name="order_id" id="modal_order_id">
      <input type="hidden" name="rating" id="rating_value">

      <div class="star-rating">
        <span onclick="setRating(1)">★</span>
        <span onclick="setRating(2)">★</span>
        <span onclick="setRating(3)">★</span>
        <span onclick="setRating(4)">★</span>
        <span onclick="setRating(5)">★</span>
      </div>

      <textarea name="review_text" required></textarea>
      <input type="file" name="review_image">

      <div class="review-actions">
  <button type="button" class="btn-cancel" onclick="closeReviewModal()">Cancel</button>
  <button type="submit" class="btn-submit">Submit Review</button>
</div>

    </form>

  </div>
</div>

<script>

// ---------- CARD NAVIGATION ----------
function handleCardClick(event, orderId) {
  if (event.target.closest('.review-btn') || event.target.closest('#reviewModal')) {
    return;
  }
  window.location.href = "/orders/" + orderId;
}

// ---------- OPEN MODAL ----------
function openReviewModal(productId, orderId){
  document.getElementById('reviewModal').style.display = 'flex';
  document.getElementById('modal_product_id').value = productId;
  document.getElementById('modal_order_id').value = orderId;
}

// ---------- CLOSE MODAL ----------
function closeReviewModal(){
  document.getElementById('reviewModal').style.display = 'none';
}

// ---------- STAR RATING ----------
function setRating(val){
  document.getElementById('rating_value').value = val;

  const stars = document.querySelectorAll('.star-rating span');
  stars.forEach((s, i) => {
    s.style.color = i < val ? '#f5b301' : '#ccc';
  });
}

// ---------- CLOSE WHEN CLICK OUTSIDE ----------
document.addEventListener('DOMContentLoaded', function () {
  const modal = document.getElementById('reviewModal');

  modal.addEventListener('click', function () {
    closeReviewModal();
  });
});

</script>
<%- include('../partials/footer') %>
</body>
</html>
