/>

    <button type="button">
      <i class="fa fa-search"></i>
    </button>
    <div id="searchDropdown" class="search-dropdown"></div>
  </div>
<div class="top-actions">
<!-- BLOG ICON -->
<div class="blog-shortcut">
  <a href="/blog" title="Blog">
