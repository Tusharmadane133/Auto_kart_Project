<%- include('../partials/header') %>

<!-- SEO Meta Tags -->
<%- generateMetaTags(meta, hreflangUrls) %>

<!-- Structured Data -->
<script type="application/ld+json">
<%- JSON.stringify(structuredData) %>
</script>

<style>
  /* Professional Blog Styles - AutoKart Brand */
  .blog-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 40px 20px;
    display: grid;
    grid-template-columns: 1fr 350px;
    gap: 40px;
    background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
    min-height: 100vh;
  }

  .blog-main {
    min-width: 0;
  }

  .blog-sidebar {
    min-width: 0;
  }

  .blog-header {
    text-align: center;
    margin-bottom: 50px;
    padding: 40px 20px;
    background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);
    border-radius: 15px;
    color: white;
    box-shadow: 0 10px 30px rgba(0, 123, 255, 0.3);
    position: relative;
    overflow: hidden;
  }

  .blog-header::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grid" width="10" height="10" patternUnits="userSpaceOnUse"><path d="M 10 0 L 0 0 0 10" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="1"/></pattern></defs><rect width="100" height="100" fill="url(%23grid)"/></svg>');
    opacity: 0.3;
  }

  .blog-header h1 {
    font-size: 3rem;
    font-weight: 700;
    margin-bottom: 15px;
    position: relative;
    text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
  }

  .blog-header p {
    font-size: 1.2rem;
    opacity: 0.9;
    position: relative;
    max-width: 600px;
    margin: 0 auto;
  }

  .blog-post {
    background: white;
    border-radius: 15px;
    overflow: hidden;
    margin-bottom: 35px;
    box-shadow: 0 5px 25px rgba(0,0,0,0.08);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    position: relative;
  }

  .blog-post::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, #007bff, #28a745);
    transform: scaleX(0);
    transition: transform 0.3s ease;
  }

  .blog-post:hover::before {
    transform: scaleX(1);
  }

  .blog-post:hover {
    transform: translateY(-8px);
    box-shadow: 0 15px 40px rgba(0,0,0,0.15);
  }

  .blog-post-image {
    width: 100%;
    height: 280px;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .blog-post:hover .blog-post-image {
    transform: scale(1.05);
  }

  .blog-post-content {
    padding: 30px;
  }

  .blog-post-title {
    font-size: 1.8rem;
    font-weight: 600;
    color: #2c3e50;
    margin-bottom: 15px;
    text-decoration: none;
    display: block;
    line-height: 1.3;
    transition: color 0.3s ease;
  }

  .blog-post-title:hover {
    color: #007bff;
  }

  .blog-post-meta {
    display: flex;
    gap: 20px;
    margin-bottom: 20px;
    font-size: 0.9rem;
    color: #6c757d;
    flex-wrap: wrap;
  }

  .blog-post-meta span {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .blog-post-excerpt {
    color: #495057;
    line-height: 1.7;
    margin-bottom: 20px;
    font-size: 1.05rem;
  }

  .blog-post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .tag {
    background: linear-gradient(135deg, #e9ecef, #dee2e6);
    color: #495057;
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 0.85rem;
    text-decoration: none;
    transition: all 0.3s ease;
    border: 1px solid transparent;
    font-weight: 500;
  }

  .tag:hover {
    background: linear-gradient(135deg, #007bff, #0056b3);
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(0, 123, 255, 0.3);
  }

  .sidebar-section {
    background: white;
    border-radius: 15px;
    padding: 25px;
    margin-bottom: 30px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .sidebar-section:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 30px rgba(0,0,0,0.12);
  }

  .sidebar-title {
    font-size: 1.4rem;
    font-weight: 600;
    color: #2c3e50;
    margin-bottom: 20px;
    padding-bottom: 12px;
    border-bottom: 3px solid #007bff;
    position: relative;
  }

  .sidebar-title::after {
    content: '';
    position: absolute;
    bottom: -3px;
    left: 0;
    width: 50px;
    height: 3px;
    background: linear-gradient(90deg, #28a745, #007bff);
  }

  .category-list,
  .tag-list {
    list-style: none;
    padding: 0;
  }

  .category-list li,
  .tag-list li {
    margin-bottom: 12px;
  }

  .category-list a,
  .tag-list a {
    color: #495057;
    text-decoration: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 15px;
    border-radius: 8px;
    transition: all 0.3s ease;
    font-weight: 500;
  }

  .category-list a:hover,
  .tag-list a:hover {
    background: linear-gradient(135deg, #007bff, #0056b3);
    color: white;
    transform: translateX(5px);
  }

  .post-count {
    background: linear-gradient(135deg, #e9ecef, #dee2e6);
    color: #495057;
    padding: 4px 10px;
    border-radius: 12px;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .category-list a:hover .post-count,
  .tag-list a:hover .post-count {
    background: rgba(255, 255, 255, 0.2);
    color: white;
  }

  .loading {
    text-align: center;
    padding: 60px;
    color: #6c757d;
    font-size: 1.1rem;
  }

  .loading::before {
    content: '';
    display: inline-block;
    width: 40px;
    height: 40px;
    border: 4px solid #f3f3f3;
    border-top: 4px solid #007bff;
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin-right: 15px;
    vertical-align: middle;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  .pagination {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin: 50px 0;
    flex-wrap: wrap;
  }

  .pagination a,
  .pagination span {
    padding: 12px 18px;
    border: 2px solid #e9ecef;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.3s ease;
    font-weight: 500;
    min-width: 45px;
    text-align: center;
  }

  .pagination a:hover {
    background: linear-gradient(135deg, #007bff, #0056b3);
    color: white;
    border-color: #007bff;
    transform: translateY(-2px);
  }

  .pagination .active {
    background: linear-gradient(135deg, #007bff, #0056b3);
    color: white;
    border-color: #007bff;
    box-shadow: 0 4px 15px rgba(0, 123, 255, 0.3);
  }

.blog-search-box {
    margin-bottom: 35px;
    position: relative;
  }

  .blog-search-box input {
    width: 100%;
    padding: 15px 20px 15px 50px;
    border: 2px solid #e9ecef;
    border-radius: 10px;
    font-size: 1rem;
    transition: all 0.3s ease;
    background: white;
  }

  .blog-search-box::before {
    content: '🔍';
    position: absolute;
    left: 18px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 1.2rem;
  }

  .blog-search-box input:focus {
    outline: none;
    border-color: #007bff;
    box-shadow: 0 0 0 3px rgba(0, 123, 255, 0.1);
  }

  .no-posts {
    text-align: center;
    padding: 60px;
    color: #6c757d;
    font-size: 1.1rem;
    background: white;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.08);
  }

  .no-posts::before {
    content: '📝';
    display: block;
    font-size: 3rem;
    margin-bottom: 20px;
  }

  /* Recent Posts Styling */
  #recentPosts div {
    padding: 15px;
    border-left: 3px solid #007bff;
    background: #f8f9fa;
    border-radius: 0 8px 8px 0;
    margin-bottom: 15px;
    transition: all 0.3s ease;
  }

  #recentPosts div:hover {
    background: #e9ecef;
    transform: translateX(5px);
  }

  #recentPosts a {
    color: #2c3e50;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    display: block;
    margin-bottom: 5px;
  }

  #recentPosts a:hover {
    color: #007bff;
  }

  #recentPosts div div {
    font-size: 0.8rem;
    color: #6c757d;
    margin-top: 5px;
    padding: 0;
    background: none;
    border: none;
    border-radius: 0;
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .blog-container {
      grid-template-columns: 1fr;
      gap: 30px;
      padding: 30px 15px;
    }

    .blog-header h1 {
      font-size: 2.5rem;
    }
  }

  @media (max-width: 768px) {
    .blog-container {
      padding: 20px 10px;
    }

    .blog-header {
      padding: 30px 15px;
    }

    .blog-header h1 {
      font-size: 2rem;
    }

    .blog-header p {
      font-size: 1rem;
    }

    .blog-post-content {
      padding: 20px;
    }

    .blog-post-title {
      font-size: 1.5rem;
    }

    .blog-post-meta {
      flex-direction: column;
      gap: 8px;
    }

    .sidebar-section {
      padding: 20px;
    }
  }

  /* Animation for page load */
  .blog-post {
    animation: fadeInUp 0.6s ease-out;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<div class="blog-container">
  <main class="blog-main">
    <div class="blog-header">
      <h1>
        <%= currentLang === "mr" ? "ऑटोकार्ट ब्लॉग" : "AutoKart Blog" %>
      </h1>
      <p>
        <%= currentLang === "mr" 
          ? "ऑटो पार्ट्स आणि कार देखभाल यासंबंधित टिप्स, मार्गदर्शक आणि अपडेट्स"
          : "Tips, guides, and news about auto parts and car maintenance" %>
      </p>
    </div>

    <div class="blog-search-box">
      <input 
        type="text" 
        id="searchInput" 
        placeholder="<%= currentLang === 'mr' ? 'ब्लॉग पोस्ट शोधा...' : 'Search blog posts...' %>" 
        onkeyup="searchPosts()">
    </div>

    <div id="loadingSpinner" class="loading">
      <div>
        <%= currentLang === "mr" 
          ? "ब्लॉग पोस्ट लोड होत आहेत..." 
          : "Loading blog posts..." %>
      </div>
    </div>

    <div id="blogPostsContainer">
      <!-- Blog posts will be loaded here -->
    </div>

    <div id="paginationContainer">
      <!-- Pagination will be loaded here -->
    </div>
  </main>

  <aside class="blog-sidebar">
    <div class="sidebar-section">
      <h3 class="sidebar-title">
        <%= currentLang === "mr" ? "विभाग" : "Categories" %>
      </h3>
      <ul id="categoriesList" class="category-list">
        <!-- Categories will be loaded here -->
      </ul>
    </div>

    <div class="sidebar-section">
      <h3 class="sidebar-title">
        <%= currentLang === "mr" ? "लोकप्रिय टॅग्स" : "Popular Tags" %>
      </h3>
      <ul id="tagsList" class="tag-list">
        <!-- Tags will be loaded here -->
      </ul>
    </div>

    <div class="sidebar-section">
      <h3 class="sidebar-title">
        <%= currentLang === "mr" ? "अलीकडील पोस्ट्स" : "Recent Posts" %>
      </h3>
      <div id="recentPosts">
        <!-- Recent posts will be loaded here -->
      </div>
    </div>
  </aside>
</div>

<%- include('../partials/footer') %>

  <script>
    let currentPage = 1;
    let searchQuery = '';
    let currentCategory = '';
    let currentTag = '';

    function loadPosts(page = 1, search = '', category = '', tag = '') {
      currentPage = page;
      searchQuery = search;
      currentCategory = category;
      currentTag = tag;
      
      const loadingSpinner = document.getElementById('loadingSpinner');
      const container = document.getElementById('blogPostsContainer');
      
      loadingSpinner.style.display = 'block';
      container.innerHTML = '';

      let url = `/api/blog/posts?page=${page}`;
      if (search) url += `&search=${encodeURIComponent(search)}`;
      if (category) url += `&category=${encodeURIComponent(category)}`;
      if (tag) url += `&tag=${encodeURIComponent(tag)}`;

      fetch(url)
        .then(response => response.json())
        .then(data => {
          loadingSpinner.style.display = 'none';
          displayPosts(data.posts);
          displayPagination(data.pagination);
        })
        .catch(error => {
          console.error('Error loading posts:', error);
          loadingSpinner.style.display = 'none';
          container.innerHTML = '<div class="no-posts">Error loading blog posts. Please try again.</div>';
        });
    }

    function formatBlogExcerpt(content, maxLength = 150) {
      if (!content) return 'Read more about this topic...';
      
      // Convert markdown-style formatting to plain text for excerpts
      let plainText = content
        .replace(/\*\*(.+?)\*\*/g, '$1') // Remove bold markdown
        .replace(/\*(.+?)\*/g, '$1') // Remove italic markdown
        .replace(/#{1,6}\s+/g, '') // Remove header markdown
        .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1') // Convert links to text
        .replace(/`([^`]+)`/g, '$1') // Remove code markdown
        .replace(/[-*+]\s+/g, '• ') // Convert bullet points to bullets
        .replace(/\d+\.\s+/g, '• ') // Convert numbered lists to bullets
        .replace(/\n+/g, ' ') // Convert line breaks to spaces
        .replace(/\s+/g, ' ') // Remove extra spaces
        .trim();
      
      // Truncate to maxLength
      if (plainText.length > maxLength) {
        plainText = plainText.substring(0, maxLength).trim() + '...';
      }
      
      return plainText;
    }

    function displayPosts(posts) {
      const container = document.getElementById('blogPostsContainer');
      
      if (posts.length === 0) {
        container.innerHTML = '<div class="no-posts">No blog posts found.</div>';
        return;
      }

      const postsHTML = posts.map(post => `
        <article class="blog-post">
          ${post.featured_image ? `<img src="${post.featured_image}" alt="${post.title}" class="blog-post-image">` : ''}
          <div class="blog-post-content">
            <a href="/blog/${post.slug}" class="blog-post-title">${post.title}</a>
            <div class="blog-post-meta">
              <span>📅 ${new Date(post.created_at).toLocaleDateString()}</span>
              <span>✍️ ${post.author}</span>
              <span>👁️ ${post.view_count || 0} views</span>
            </div>
            <p class="blog-post-excerpt">${post.excerpt || formatBlogExcerpt(post.content)}</p>
            <div class="blog-post-tags">
              ${post.tags.map(tag => `<a href="/blog/tag/${tag}" class="tag">${tag}</a>`).join('')}
            </div>
          </div>
        </article>
      `).join('');

      container.innerHTML = postsHTML;
    }

    function displayPagination(pagination) {
      const container = document.getElementById('paginationContainer');
      
      let paginationHTML = '<div class="pagination">';
      
      if (pagination.has_prev) {
        paginationHTML += `<a href="#" onclick="loadPosts(${pagination.current_page - 1}, '${searchQuery}', '${currentCategory}', '${currentTag}'); return false;">Previous</a>`;
      }
      
      for (let i = 1; i <= pagination.total_pages; i++) {
        const activeClass = i === pagination.current_page ? 'active' : '';
        paginationHTML += `<a href="#" class="${activeClass}" onclick="loadPosts(${i}, '${searchQuery}', '${currentCategory}', '${currentTag}'); return false;">${i}</a>`;
      }
      
      if (pagination.has_next) {
        paginationHTML += `<a href="#" onclick="loadPosts(${pagination.current_page + 1}, '${searchQuery}', '${currentCategory}', '${currentTag}'); return false;">Next</a>`;
      }
      
      paginationHTML += '</div>';
      container.innerHTML = paginationHTML;
    }

    function loadCategories() {
      fetch('/api/blog/categories')
        .then(response => response.json())
        .then(categories => {
          const container = document.getElementById('categoriesList');
          container.innerHTML = categories.map(category => `
            <li>
              <a href="#" onclick="filterByCategory('${category.slug}'); return false;">
                ${category.name}
                <span class="post-count">${category.post_count || 0}</span>
              </a>
            </li>
          `).join('');
        })
        .catch(error => console.error('Error loading categories:', error));
    }

    function loadTags() {
      fetch('/api/blog/tags')
        .then(response => response.json())
        .then(tags => {
          const container = document.getElementById('tagsList');
          container.innerHTML = tags.slice(0, 10).map(tag => `
            <li>
              <a href="#" onclick="filterByTag('${tag.slug}'); return false;">
                ${tag.name}
                <span class="post-count">${tag.post_count || 0}</span>
              </a>
            </li>
          `).join('');
        })
        .catch(error => console.error('Error loading tags:', error));
    }

    function loadRecentPosts() {
      fetch('/api/blog/posts?limit=5')
        .then(response => response.json())
        .then(data => {
          const container = document.getElementById('recentPosts');
          container.innerHTML = data.posts.map(post => `
            <div style="margin-bottom: 15px;">
              <a href="/blog/${post.slug}" style="color: #333; text-decoration: none; font-size: 0.9rem;">
                ${post.title}
              </a>
              <div style="font-size: 0.8rem; color: #666; margin-top: 3px;">
                ${new Date(post.created_at).toLocaleDateString()}
              </div>
            </div>
          `).join('');
        })
        .catch(error => console.error('Error loading recent posts:', error));
    }

    function searchPosts() {
      const searchInput = document.getElementById('searchInput');
      loadPosts(1, searchInput.value);
    }

    function filterByCategory(categorySlug) {
      loadPosts(1, '', categorySlug);
    }

    function filterByTag(tagSlug) {
      loadPosts(1, '', '', tagSlug);
    }

    // Load data when page loads
    document.addEventListener('DOMContentLoaded', function() {
      loadPosts();
      loadCategories();
      loadTags();
      loadRecentPosts();
    });
  </script>
</body>
</html>