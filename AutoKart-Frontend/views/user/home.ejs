          </a>

        <% }) %>
      </div>

    </div>

  </div>
</div>

<% } %>

   


    <!-- SECTION 2 : VEHICLE TYPE (NO HEADING) -->
    <% if (index === 1) { %>
      <div class="vehicle-type-section">

        <div class="vehicle-wrapper">

          <!-- LEFT : 4 VEHICLE PRODUCTS -->
          <div class="vehicle-left">
            <div class="vehicle-product-grid">

              <% productsBySection[section.id].slice(0,4).forEach(p => { %>
                <a href="/product/<%= p.display_slug %>?lang=<%= currentLang %>" style="text-decoration:none;color:inherit;">

                  <div class="vehicle-product-card" style="position: relative;">
                    <% if (p.discount && p.discount > 0) { %>
                      <div style="position: absolute; top: 10px; right: 10px; background: #ff3e6c; color: white; padding: 2px 8px; border-radius: 3px; font-size: 11px; font-weight: bold; z-index: 2;">
                        <%= Math.round(p.discount) %>% OFF
                      </div>
                    <% } %>
                    <img src="/uploads/<%= p.image %>">
                    <h4 class="auto-translate"><%= p.product_name %></h4>

                    <div class="price-container" style="display: flex; align-items: center; gap: 6px; margin-top: 8px; justify-content: center; flex-wrap: wrap;">
            <% if (p.discount && p.discount > 0) { %>
              <span style="text-decoration: line-through; color: #878787; font-size: 13px;">
                ₹<%= p.original_price || p.price %>
              </span>
              <span style="color: #388e3c; font-weight: bold; font-size: 15px;">
                ₹<%= Math.round(p.price) %>
              </span>
            <% } else { %>
              <span style="color: #388e3c; font-weight: bold; font-size: 15px;">
                ₹<%= Math.round(p.price) %>
              </span>
            <% } %>
          </div>
                  </div>
                </a>
              <% }) %>

            </div>
          </div>

          <!-- RIGHT : BIG PROMOTIONAL BANNER -->
       <% if (middleBanner) { %>

<div class="middle-banner">
  <a href="<%= middleBanner.redirect_url %>">
    <img
      src="/uploads/middle-banner/<%= middleBanner.image %>"
      alt="Middle Banner"
    >
  </a>
</div>

<% } %>
</div>
<% } %>
    <% if (index ===2) { %>
  <!-- =========================
       HOME SLIDER (BETWEEN VEHICLE & CATEGORIES)
  ========================= -->
 

<% } %>


<script>
  (function() {
    try {
      const fkSlides = document.querySelectorAll(".fk-slide");
      const fkDots = document.querySelectorAll(".fk-dots .dot");
      const fkNext = document.querySelector(".fk-next");
      const fkPrev = document.querySelector(".fk-prev");

      // Only initialize if elements exist
      if (fkSlides.length > 0 && fkDots.length > 0) {
        let fkCurrent = 0;

        function showFkSlide(index) {
          fkSlides.forEach((slide, i) => {
            if (slide) slide.classList.toggle("active", i === index);
            if (fkDots[i]) fkDots[i].classList.toggle("active", i === index);
          });
          fkCurrent = index;
        }

        // Initialize first slide
        showFkSlide(0);

        // AUTO SLIDE (3 sec)
        let slideInterval = setInterval(() => {
          if (fkSlides.length > 0) {
            showFkSlide((fkCurrent + 1) % fkSlides.length);
          }
        }, 6000);

        // MANUAL CONTROLS
        if (fkNext) {
          fkNext.onclick = () => {
            clearInterval(slideInterval);
            showFkSlide((fkCurrent + 1) % fkSlides.length);
            slideInterval = setInterval(() => {
              showFkSlide((fkCurrent + 1) % fkSlides.length);
            }, 6000);
          };
        }

        if (fkPrev) {
          fkPrev.onclick = () => {
            clearInterval(slideInterval);
            showFkSlide((fkCurrent - 1 + fkSlides.length) % fkSlides.length);
            slideInterval = setInterval(() => {
              showFkSlide((fkCurrent + 1) % fkSlides.length);
            }, 6000);
          };
        }

        fkDots.forEach((dot, i) => {
          if (dot) {
            dot.onclick = () => {
              clearInterval(slideInterval);
              showFkSlide(i);
              slideInterval = setInterval(() => {
                showFkSlide((fkCurrent + 1) % fkSlides.length);
              }, 6000);
            };
          }
        });
      }
    } catch (error) {
      console.error('Error initializing slider:', error);
    }
  })();
</script>

 
