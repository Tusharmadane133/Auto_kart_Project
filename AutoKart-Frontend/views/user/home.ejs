        muteBtn.textContent = "🔇";
      } else {
        muteBtn.textContent = "🔊";
      }
    });
  }
</script>

<script>
async function translateText(text) {
  try {
    const res = await fetch(
      "https://translate.googleapis.com/translate_a/single?client=gtx&sl=en&tl=mr&dt=t&q=" 
      + encodeURIComponent(text)
    );

    const data = await res.json();
    return data[0][0][0];
  } catch (error) {
    console.error("Translation error:", error);
    return text;
  }
}

async function translateElements() {

  const currentLang = "<%= currentLang %>";

  if (currentLang !== "mr") return;

  const elements = document.querySelectorAll(".auto-translate");

  for (let el of elements) {
    const originalText = el.innerText.trim();
    if (!originalText) continue;

    const translated = await translateText(originalText);
    el.innerText = translated;
  }
}

document.addEventListener("DOMContentLoaded", translateElements);
</script>

