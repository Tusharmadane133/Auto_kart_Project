        <%= total %> global ratings
      </div>

      <% for (let star = 5; star >= 1; star--) {
           let percent = total > 0 ? Math.round((counts[star] / total) * 100) : 0;
      %>

      <div class="rating-row">
        <span class="star-label"><%= star %> star</span>

        <div class="bar">
          <div class="fill" data-percent="<%= percent %>"></div>
        </div>

        <span class="percent"><%= percent %>%</span>
      </div>

      <% } %>

    </div>


    <!-- ================= RIGHT COLUMN ================= -->
    <div class="review-content">

      <!-- Images -->
      <div class="review-images">
        <h3>Reviews with images</h3>

        <div class="image-row">
          <% reviews.forEach(r => { if(r.review_image){ %>
            <img 
  src="/uploads/reviews/<%= r.review_image %>" 
  class="review-thumb"
>
          <% } }) %>
        </div>
      </div>


      <!-- Review List -->
      <div class="review-list">
        <% reviews.forEach(review => { %>

        <div class="review-card">

          <h4><%= review.user_first_name %> <%= review.user_last_name %></h4>

        <%
   const ratingValue = Number(review.rating) || 0;
%>

<div class="stars">
  <% for (let i = 1; i <= 5; i++) { %>
    <% if (i <= ratingValue) { %>
      <span class="star filled">★</span>
    <% } else { %>
      <span class="star">★</span>
    <% } %>
  <% } %>
</div>

          <p class="review-date">
            Reviewed on
            <%= new Date(review.created_at).toLocaleDateString('en-IN',{
              day:'numeric', month:'long', year:'numeric'
            }) %>
          </p>

          <p class="review-text"><%= review.review_text %></p>

       

        

        </div>

        <% }) %>
      </div>

    </div>

  </div>

  </div>
</section>

<script>
document.addEventListener("DOMContentLoaded", function () {
  document.querySelectorAll(".fill").forEach(function(el){
    const percent = el.getAttribute("data-percent");
    el.style.width = percent + "%";
  });
});
</script>
<script>
document.addEventListener("DOMContentLoaded", function(){

  const lightbox = document.getElementById("reviewLightbox");
  const lightboxImg = document.getElementById("lightboxImage");
  const closeBtn = document.querySelector(".lightbox-close");

  // open lightbox
  document.querySelectorAll(".review-thumb").forEach(img => {
    img.addEventListener("click", function(){
      lightbox.style.display = "flex";
      lightboxImg.src = this.src;
      document.body.style.overflow = "hidden";
    });
  });

  // close button
  closeBtn.addEventListener("click", function(){
    lightbox.style.display = "none";
    document.body.style.overflow = "auto";
  });

  // click outside to close
  lightbox.addEventListener("click", function(e){
    if(e.target === lightbox){
      lightbox.style.display = "none";
      document.body.style.overflow = "auto";
    }
  });

});
</script>


<!-- REVIEW IMAGE LIGHTBOX -->
<div id="reviewLightbox" class="review-lightbox">
  <span class="lightbox-close">&times;</span>

  <div class="lightbox-container">
    <img id="lightboxImage" class="lightbox-image">
  </div>
</div>
<%- include('partials/footer') %>

</body>
</html>